{
  "name": "@snowbros/scene",
  "version": "0.1.0",
  "description": "Three.js toolkit: managed stages, scroll-driven camera rigs, model loading, procedural shader materials, adaptive quality and graceful fallbacks.",
  "license": "(MIT OR Apache-2.0)",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check:package": "publint"
  },
  "keywords": [
    "three",
    "webgl",
    "3d",
    "camera",
    "gltf",
    "shader",
    "snowbros"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/snowbros-labs/creative-engineering.git",
    "directory": "packages/scene"
  },
  "homepage": "https://github.com/snowbros-labs/creative-engineering/tree/main/packages/scene#readme",
  "bugs": "https://github.com/snowbros-labs/creative-engineering/issues",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@snowbros/core": "workspace:^"
  },
  "peerDependencies": {
    "three": ">=0.159.0"
  },
  "devDependencies": {
    "three": "0.186.1",
    "@types/three": "0.186.0"
  }
}
