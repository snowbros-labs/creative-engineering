{
  "name": "@snowbros/adapters",
  "version": "0.1.0",
  "description": "Interop with Lenis, GSAP and Motion (motion.dev): share one frame loop and drive their animations from SNOWBROS progress sources. Structural typing only — never imports or bundles those libraries.",
  "license": "(MIT OR Apache-2.0)",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check:package": "publint"
  },
  "keywords": [
    "lenis",
    "gsap",
    "motion",
    "interop",
    "adapter",
    "snowbros"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/snowbros-labs/creative-engineering.git",
    "directory": "packages/adapters"
  },
  "homepage": "https://github.com/snowbros-labs/creative-engineering/tree/main/packages/adapters#readme",
  "bugs": "https://github.com/snowbros-labs/creative-engineering/issues",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@snowbros/core": "workspace:^"
  },
  "peerDependencies": {
    "lenis": "^1.1.0",
    "gsap": "^3.12.0",
    "motion": ">=11.0.0"
  },
  "peerDependenciesMeta": {
    "lenis": {
      "optional": true
    },
    "gsap": {
      "optional": true
    },
    "motion": {
      "optional": true
    }
  }
}
