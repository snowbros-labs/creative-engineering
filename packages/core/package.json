{
  "name": "@snowbros/core",
  "version": "0.2.0",
  "description": "Dependency-free foundation for SNOWBROS Creative Engineering: shared frame ticker, easing, springs, lifecycle scopes, capability and motion-preference detection.",
  "license": "(MIT OR Apache-2.0)",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check:package": "publint"
  },
  "keywords": [
    "animation",
    "motion",
    "easing",
    "spring",
    "ticker",
    "reduced-motion",
    "snowbros"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/snowbros-labs/creative-engineering.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/snowbros-labs/creative-engineering/tree/main/packages/core#readme",
  "bugs": "https://github.com/snowbros-labs/creative-engineering/issues",
  "publishConfig": {
    "access": "public"
  }
}
