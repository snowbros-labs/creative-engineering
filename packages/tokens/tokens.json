{
  "$description": "SNOWBROS design tokens (W3C Design Tokens Community Group format). Motion values are derived from cited public systems — see packages/tokens/README.md.",
  "motion": {
    "duration": {
      "$type": "duration",
      "instant": {
        "$value": { "value": 70, "unit": "ms" },
        "$description": "Micro feedback: press, toggle tick. (Carbon fast-01)"
      },
      "quick": {
        "$value": { "value": 110, "unit": "ms" },
        "$description": "Hover, small state changes. (Carbon fast-02)"
      },
      "base": {
        "$value": { "value": 150, "unit": "ms" },
        "$description": "Default functional transition. (Carbon moderate-01)"
      },
      "moderate": {
        "$value": { "value": 240, "unit": "ms" },
        "$description": "Popovers, menus, dialogs entering. (Carbon moderate-02)"
      },
      "slow": {
        "$value": { "value": 400, "unit": "ms" },
        "$description": "Large panels, route changes, expressive UI. (Carbon slow-01)"
      },
      "deliberate": {
        "$value": { "value": 700, "unit": "ms" },
        "$description": "Expressive reveals, hero entrances. (Carbon slow-02)"
      },
      "cinematic": {
        "$value": { "value": 1000, "unit": "ms" },
        "$description": "Marketing-only spatial moves; always interruptible. (Material 3 extra-long upper bound)"
      }
    },
    "easing": {
      "$type": "cubicBezier",
      "functional-standard": {
        "$value": [0.2, 0, 0.38, 0.9],
        "$description": "Carbon productive standard."
      },
      "functional-enter": {
        "$value": [0, 0, 0.38, 0.9],
        "$description": "Carbon productive entrance."
      },
      "functional-exit": { "$value": [0.2, 0, 1, 0.9], "$description": "Carbon productive exit." },
      "expressive-standard": {
        "$value": [0.4, 0.14, 0.3, 1],
        "$description": "Carbon expressive standard."
      },
      "expressive-enter": {
        "$value": [0, 0, 0.3, 1],
        "$description": "Carbon expressive entrance."
      },
      "expressive-exit": { "$value": [0.4, 0.14, 1, 1], "$description": "Carbon expressive exit." },
      "emphasized": { "$value": [0.2, 0, 0, 1], "$description": "Material 3 emphasized." },
      "emphasized-decelerate": {
        "$value": [0.05, 0.7, 0.1, 1],
        "$description": "Material 3 emphasized decelerate."
      },
      "emphasized-accelerate": {
        "$value": [0.3, 0, 0.8, 0.15],
        "$description": "Material 3 emphasized accelerate."
      },
      "editorial": {
        "$value": [0.16, 1, 0.3, 1],
        "$description": "SNOWBROS: long decisive deceleration for type reveals."
      },
      "cinematic": {
        "$value": [0.65, 0, 0.35, 1],
        "$description": "SNOWBROS: symmetric in-out for camera and large spatial moves."
      }
    },
    "stagger": {
      "$type": "duration",
      "tight": { "$value": { "value": 20, "unit": "ms" }, "$description": "Characters." },
      "base": { "$value": { "value": 50, "unit": "ms" }, "$description": "Words, list items." },
      "loose": { "$value": { "value": 90, "unit": "ms" }, "$description": "Lines, cards." }
    }
  },
  "color": {
    "$type": "color",
    "ink": { "$value": "#0b0c0e", "$description": "Primary text / dark surface." },
    "graphite": { "$value": "#1d1f23", "$description": "Raised dark surface." },
    "slate": { "$value": "#3a3d44", "$description": "Borders on dark, secondary text on light." },
    "mist": {
      "$value": "#8a8f98",
      "$description": "Tertiary text; meets 3:1 on snow for large text/UI only."
    },
    "frost": { "$value": "#d9dee5", "$description": "Hairlines and quiet fills on light." },
    "snow": { "$value": "#f3f2ee", "$description": "Primary light surface (warm off-white)." },
    "paper": { "$value": "#fbfaf7", "$description": "Raised light surface." },
    "glacier": { "$value": "#7fa7d9", "$description": "Cold accent for data and focus on dark." },
    "signal": {
      "$value": "#ff4f1f",
      "$description": "Single warm accent: calls to action, live state. Use sparingly."
    },
    "positive": { "$value": "#1f8a5b", "$description": "Success state." },
    "caution": { "$value": "#b7791f", "$description": "Warning state." },
    "critical": { "$value": "#d23b2f", "$description": "Error state." }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "display": {
        "$value": ["Instrument Serif", "Iowan Old Style", "Georgia", "serif"],
        "$description": "Editorial display. OFL-1.1."
      },
      "sans": {
        "$value": ["Inter Tight", "Inter", "system-ui", "sans-serif"],
        "$description": "UI and body. OFL-1.1."
      },
      "mono": {
        "$value": ["JetBrains Mono", "ui-monospace", "SFMono-Regular", "monospace"],
        "$description": "Labels, data, code. OFL-1.1."
      }
    }
  },
  "space": {
    "$type": "dimension",
    "1": { "$value": { "value": 4, "unit": "px" } },
    "2": { "$value": { "value": 8, "unit": "px" } },
    "3": { "$value": { "value": 12, "unit": "px" } },
    "4": { "$value": { "value": 16, "unit": "px" } },
    "5": { "$value": { "value": 24, "unit": "px" } },
    "6": { "$value": { "value": 32, "unit": "px" } },
    "7": { "$value": { "value": 48, "unit": "px" } },
    "8": { "$value": { "value": 64, "unit": "px" } },
    "9": { "$value": { "value": 96, "unit": "px" } },
    "10": { "$value": { "value": 144, "unit": "px" } }
  },
  "radius": {
    "$type": "dimension",
    "sm": { "$value": { "value": 4, "unit": "px" } },
    "md": { "$value": { "value": 8, "unit": "px" } },
    "lg": { "$value": { "value": 14, "unit": "px" } },
    "pill": { "$value": { "value": 999, "unit": "px" } }
  }
}
