{
  "name": "@snowbros/elements",
  "version": "0.1.0",
  "description": "Framework-agnostic Web Components for SNOWBROS Creative Engineering — use reveals, pins and effects from plain HTML, Vue, Svelte, Astro or any server-rendered stack.",
  "license": "(MIT OR Apache-2.0)",
  "type": "module",
  "sideEffects": [
    "./dist/define.js",
    "./src/define.ts"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./define": {
      "types": "./dist/define.d.ts",
      "default": "./dist/define.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check:package": "publint"
  },
  "keywords": [
    "web-components",
    "custom-elements",
    "vue",
    "svelte",
    "astro",
    "snowbros"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/snowbros-labs/creative-engineering.git",
    "directory": "packages/elements"
  },
  "homepage": "https://github.com/snowbros-labs/creative-engineering/tree/main/packages/elements#readme",
  "bugs": "https://github.com/snowbros-labs/creative-engineering/issues",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@snowbros/core": "workspace:^",
    "@snowbros/motion": "workspace:^",
    "@snowbros/fx": "workspace:^"
  }
}
