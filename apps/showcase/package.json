    "@snowbros/tokens": "workspace:^",
    "@snowbros/elements": "workspace:^",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/three": "0.186.0",
    "vite": "8.3.5"
  }
}
