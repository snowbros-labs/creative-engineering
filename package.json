{
  "name": "snowbros-creative-engineering",
  "private": true,
  "description": "SNOWBROS Creative Engineering — an AI skill plus a modular toolkit for motion, scroll choreography, 3D and premium interfaces.",
  "license": "(MIT OR Apache-2.0)",
  "type": "module",
  "packageManager": "pnpm@11.1.1",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/**\" run build",
    "build:all": "pnpm -r run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm --filter @snowbros/showcase --filter @snowbros/website run test:e2e",
    "typecheck": "pnpm -r run typecheck",
    "lint": "biome check .",
    "format": "biome format --write .",
    "validate:skill": "node tools/validate-skill.mjs",
    "check:packages": "pnpm -r --filter \"./packages/**\" run check:package",
    "dev": "pnpm --filter @snowbros/showcase run dev",
    "ci": "pnpm lint && pnpm build && pnpm typecheck && pnpm test && pnpm validate:skill && pnpm check:packages",
    "changeset": "changeset"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "happy-dom": "21.0.4",
    "publint": "0.3.25",
    "typescript": "7.0.2",
    "vitest": "5.0.5",
    "@changesets/cli": "3.0.3"
  }
}
