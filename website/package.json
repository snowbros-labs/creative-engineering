{
  "name": "@snowbros/website",
  "version": "0.1.0",
  "private": true,
  "description": "The SNOWBROS Creative Engineering project website — built with the snowbros-creative skill and the @snowbros/* toolkit.",
  "license": "(MIT OR Apache-2.0)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4174 --strictPort",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:e2e": "playwright test",
    "build:site": "vite build && pnpm --filter @snowbros/showcase exec vite build --outDir ../../website/dist/demos --emptyOutDir"
  },
  "dependencies": {
    "@snowbros/core": "workspace:^",
    "@snowbros/fx": "workspace:^",
    "@snowbros/motion": "workspace:^",
    "@snowbros/scene": "workspace:^",
    "@snowbros/tokens": "workspace:^",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/three": "0.186.0",
    "vite": "8.3.5"
  }
}
